# .dockerignore

# Git
.git/
.gitignore

# Docker
Dockerfile
.dockerignore

# Environment files are injected at runtime, not copied into the image.
.env
*.env
.env.*
!.env.example

# Python virtual environments and caches
__pycache__/
*.py[cod]
*$py.class
*pytest*
# Keep local native build artifacts out of the image; runtime dependencies are installed by pip/uv.
.Python
env/
venv/
ENV/
.venv
.env

# Python build/package artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.sublime-workspace
*.sublime-project

# Logs are produced by the running container, not baked into the image.
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
.cache
*tmp*
*temp*

# Jupyter notebooks are development-only.
*.ipynb
*.ipynb_*

# Local data files
*.csv
*.xlsx
*.xls
*.db
*.sqlite3
*.txt 
!requirements.txt

# Files not needed in the production image
README.md
**/*.md

**/tests/
**/docs/

# Helper scripts are development-only and not needed in the production image.
scripts/
run*

