# ============================================
# Bitfinex Lending Bot configuration
# Copy this file to .env and fill in your own values.
# ============================================

# ============== Required ==============
BFX_API_KEY=your_bitfinex_api_key
BFX_API_SECRET=your_bitfinex_api_secret

# ============== Trading ==============
# Use common currency symbols such as USDT. Do not set UST manually;
# Bitfinex API-specific symbol mapping is handled in code.
SYMBOL=USDT

# Minimum gross APR (%), accounting for Bitfinex's 15% platform fee.
# Example: target net 6% -> set 6 / 0.85 ~= 7.06
MINIMUM_RATE=7.0588

# ============== Connection (optional) ==============
# WebSocket ping interval and timeout, in seconds.
# PING_INTERVAL=20
# PING_TIMEOUT=30

# ============== Timing (optional) ==============
# Main loop delay, in seconds.
# MAIN_LOOP_DELAY=2.0

# Maximum market data age, in minutes.
# MARKET_INFO_MAX_AGE_MINUTES=2.0

# Maximum wait time for market data, in minutes.
# MARKET_DATA_FETCH_TIMEOUT=0.1

# Critical market data staleness threshold, in minutes. Exceeding this triggers reconnect.
# MARKET_DATA_CRITICAL_STALE_MINUTES=20.0

# FRR-mode unfilled offer timeout, in minutes. Exceeding this cancels the offer.
# FRR_ORDER_TIMEOUT=1.0

# ============== Active mode (optional) ==============
# Active-mode sniping timeout, in seconds.
# ACTIVE_ORDER_TIMEOUT=30.0

# Circuit breaker duration, in seconds.
# CIRCUIT_BREAKER_DURATION=120

# FRR-mode failure threshold.
# FRR_FAILURE_THRESHOLD=3

# Maximum active-mode attempts before circuit breaker.
# ACTIVE_MAX_ATTEMPTS=6

# Active-mode rate discount. Example: 0.99 = 99%.
# ACTIVE_RATE_DISCOUNT=0.99

# FRR-mode rate discount. Example: 0.98 = 98%.
# FRR_RATE_DISCOUNT=0.98

# ============== Debug (optional) ==============
# Verbose output.
# VERBOSE=false

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOGGING_LEVEL=DEBUG
